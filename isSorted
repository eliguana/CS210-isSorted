#include <iostream>
#include <vector>
#include <utility>
#include <chrono>

using namespace std;

//isSorted
bool isSorted(const vector<int>& values)
{
  for (int i = 0; i < values.size() - 1; i++)
  {
      if(values[i] > values[i + 1])
      {
        return false;
      }
  }
    return true;
}
//bubble sort
void bubbleSort(vector<int>&values)
{
  int length = values.size();
  
  for (int i = 0; i < length; i++)
  {
      for(int j = 0; j < length - 1; j++)
      {
        if (values[j] > values[j + 1])
            swap(values[j], values[j + 1]);
      }
  }
}

//selection sort
void selectionSort(vector<int>&values)
{
  int length = values.size();
  for(int i = 0; i < length - 1; ++i)
  {
    int min_elem = i;
    for (int j = i + 1; j < length; ++j){
      if (values[j] < values[min_elem]) {
      min_elem = j;
    }
}
    swap (values[i], values[min_elem]);
}
}

//insertion sort
void insertionSort(vector<int>& values)
{
  int length = values.size();
  for (int i = 1; i < length; ++i){
      int key = values [i];
      int j = i - 1;
  while (j >= 0 && values[j] > key)
  {
    values[j + 1] = values [j];
    j = j - 1;
  }
    values [j + 1] = key;
  }
}

/*quick sort: 3 steps 
  1) choose a pivot
  2) partition the array (https://www.geeksforgeeks.org/dsa/hoare-s-partition-algorithm/)
  3) recursively call till base case*/

//Hoare's partition
int partition(vector<int>& values, int low, int high)
{
    int pivot = values[low];

    int i = low - 1;
    int j = high + 1;

    while (true)
    {
        do
        {
            i++;
        } while (values[i] < pivot);

        do
        {
            j--;
        } while (values[j] > pivot);

        if (i >= j)
        {
            return j;
        }

        swap(values[i], values[j]);
    }
}

//quick sort
void quickSort(vector<int>& values, int low, int high)
{
    if (low < high)
    {
        int partIndex = partition(values, low, high);

        quickSort(values, low, partIndex);
        quickSort(values, partIndex + 1, high);
    }
}

